[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scenes/CacheWarrenScene.cs" id="script"]
[ext_resource type="PackedScene" path="res://scenes/dungeon_stage.tscn" id="stage"]

; The cast is NOT authored here. Every body — the player's Workling and all four
; foes — is built at runtime from Core.Roster.CreatureRoster, placed on the
; stage's markers and sized from the height it declares. This file used to carry
; one instanced .glb per creature with the size baked into a transform, which
; made "add a Workling" a scene edit as well as a code one, and a scene edit is
; the half that cannot be reviewed in a diff.
;
; Stage is the authored Cache Warren. CacheWarrenScene.Arena selects the arena:
; the default Moonlit Ruins is built procedurally by StageSet and replaces this
; node, and StageKind.CacheWarren keeps it. It stays instanced so the original
; remains one Inspector toggle away — it is the A/B for the whole lighting call.

[node name="CacheWarren" type="Node3D"]
script = ExtResource("script")

[node name="Stage" parent="." instance=ExtResource("stage")]

[node name="Party" type="Node3D" parent="."]

[node name="Foe" type="Node3D" parent="."]
