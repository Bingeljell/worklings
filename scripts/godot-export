#!/usr/bin/env bash
#
# Builds a real, runnable Worklings.app.
#
#   scripts/godot-export                    # into dist/godot/, for local runs
#   scripts/godot-export --version 0.1.0-alpha.11   # into dist/<version>/, for a release
#
# Why this exists as a script: the export has four requirements that are all
# invisible in the editor, and rediscovering them costs an evening.
#
#   1. Godot's .NET export needs a SOLUTION file (Worklings.sln), not just the
#      .csproj the editor builds. Without it the export "succeeds" and produces
#      an app with no managed assemblies, which launches and exits in silence.
#   2. The solution needs ExportDebug / ExportRelease configurations. A solution
#      written by `dotnet sln add` has Debug/Release and will not do.
#   3. `dotnet new sln` on a current SDK writes a .slnx. Godot wants a .sln.
#   4. Apple Silicon needs ETC2 ASTC texture compression enabled in
#      project.godot, or a universal export refuses outright.
#
# The exported app is the FIRST build allowed to write the real save — see
# core/host/SaveLocation.cs. Back up ~/Library/Application Support/Worklings/
# pet-state.json before running a delve in it for the first time.
#
# **Ad-hoc signed, at the end and not by Godot.** The adapters are copied into
# Resources *after* the export, which invalidates any signature written during
# it, so signing has to be the last thing that touches the bundle. Ad-hoc only:
# it satisfies `codesign --verify`, which is what the DMG step checks, and it is
# not notarization — Gatekeeper still warns on a downloaded copy.
#
# The export is **universal**, because the .NET export templates ship one
# universal binary rather than per-arch ones; asking for arm64 fails with a
# missing-template error that names a file the archive never contained. So the
# Intel halves are stripped out afterwards instead — see below. What ships is
# Apple Silicon only, which is what the DMG name and the docs have always said.

set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
project="$repo_root/godot/worklings"
godot="${GODOT:-/Applications/Godot.app/Contents/MacOS/Godot}"

version=''
while [ "$#" -gt 0 ]; do
  case "$1" in
    --version)
      [ "$#" -ge 2 ] || { printf 'Usage: %s [--version <semver>]\n' "$0" >&2; exit 2; }
      version=$2; shift 2 ;;
    *) printf 'unknown option: %s\n' "$1" >&2; exit 2 ;;
  esac
done

if [ -n "$version" ]; then
  out="$repo_root/dist/$version/Worklings.app"
else
  out="$repo_root/dist/godot/Worklings.app"
fi

if [ ! -x "$godot" ]; then
  printf 'Godot not found at %s — set GODOT to the binary.\n' "$godot" >&2
  exit 1
fi

if [ ! -d "$HOME/Library/Application Support/Godot/export_templates" ]; then
  printf 'No export templates installed. Download the mono .tpz for this Godot\n'
  printf 'version from its GitHub release and unzip templates/* into\n'
  printf '  ~/Library/Application Support/Godot/export_templates/<version>.mono/\n' >&2
  exit 1
fi

dotnet build "$project/Worklings.sln" -c ExportRelease -v q --nologo

rm -rf "$out"
mkdir -p "$(dirname "$out")"
"$godot" --headless --path "$project" --export-release "macOS" "$out"

# The activity adapters have to be real files the operating system can execute,
# so they cannot live in res:// — that is inside the .pck, and nothing in a .pck
# is a path a hook command can name. They go where AdapterLocator looks for them,
# next to the emitter they invoke as ../emit-activity-event.
resources="$out/Contents/Resources"
mkdir -p "$resources/adapters"
cp "$repo_root/scripts/adapters/"* "$resources/adapters/"
cp "$repo_root/scripts/emit-activity-event" "$resources/"
chmod +x "$resources/adapters/"* "$resources/emit-activity-event"

# Strip the Intel halves. The export cannot be asked for arm64 (see the note at
# the top), but nothing stops thinning the finished bundle: `lipo` on the engine
# binary and the x86_64 .NET runtime deleted outright. Measured on alpha.11 this
# is 159 MB of a 350 MB app — 83 MB of fat binary and a 76 MB runtime nothing on
# an Apple Silicon Mac ever loads. The Info.plist keys that advertise x86_64 go
# with them, so the bundle does not claim an architecture it no longer carries.
#
# This has to happen before signing, like everything else that edits the bundle.
binary="$out/Contents/MacOS/Worklings"
if lipo -info "$binary" | grep -q 'x86_64'; then
  lipo -thin arm64 "$binary" -output "$binary.arm64"
  mv "$binary.arm64" "$binary"
  chmod +x "$binary"
fi
rm -rf "$resources/data_Worklings_macos_x86_64"
plutil -replace LSArchitecturePriority -json '["arm64"]' "$out/Contents/Info.plist"
plutil -remove LSMinimumSystemVersionByArchitecture.x86_64 "$out/Contents/Info.plist" 2>/dev/null || true

# Last, because copying the adapters in above invalidated whatever the export
# signed.
codesign --force --deep --sign - "$out"
codesign --verify --deep --strict "$out"

printf '\n%s\n' "$out"
du -sh "$out"
lipo -info "$out/Contents/MacOS/Worklings"
plutil -extract CFBundleShortVersionString raw -o - "$out/Contents/Info.plist"

