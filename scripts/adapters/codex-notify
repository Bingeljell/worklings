#!/usr/bin/env bash

# Codex activity adapter.
#
# Wire this to Codex's `notify` program (see docs/adapters.md). Codex passes a
# single JSON argument describing the event; today the only documented event is
# `agent-turn-complete`, which this adapter maps to a `taskCompleted` inbox
# event under the `codex` source id.
#
# Privacy: the notify payload also carries `last-assistant-message` and
# `input-messages`, which are content. This adapter must never forward them, so
# it does not parse the JSON — it only pattern-matches the event `type` and
# emits a content-free event. Nothing but "a turn completed" reaches the pet.
#
# Usage (Codex invokes it as):
#   /abs/path/scripts/adapters/codex-notify '<json>'

set -euo pipefail

payload="${1:-}"

# Locate the canonical emitter beside this script so the adapter works from any
# working directory Codex runs it in.
script_dir="$(cd "$(dirname "$0")" && pwd)"
emitter="$script_dir/../emit-activity-event"

# Match only the event type. Anything else in the payload (assistant/user
# message text) is never read, so it cannot leak. Unknown event types are
# ignored, which keeps this forward-compatible as Codex adds notifications.
case "$payload" in
  *'"type":"agent-turn-complete"'* | *'"type": "agent-turn-complete"'*)
    "$emitter" taskCompleted codex >/dev/null 2>&1 || true
    ;;
  *)
    : # not an event we map; do nothing
    ;;
esac
