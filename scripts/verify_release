#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage: scripts/verify_release --version <version> [options]

Options:
  --arch <architecture>  Packaged architecture (default: arm64)
  --output-dir <path>    Artifact directory (default: dist/<version>)
  --help                 Show this help
EOF
}

version=''
architecture='arm64'
output_dir=''

while [ "$#" -gt 0 ]; do
  case "$1" in
    --version)
      [ "$#" -ge 2 ] || { usage; exit 2; }
      version=$2
      shift 2
      ;;
    --arch)
      [ "$#" -ge 2 ] || { usage; exit 2; }
      architecture=$2
      shift 2
      ;;
    --output-dir)
      [ "$#" -ge 2 ] || { usage; exit 2; }
      output_dir=$2
      shift 2
      ;;
    --help)
      usage
      exit 0
      ;;
    *)
      printf 'Error: unknown argument: %s\n' "$1" >&2
      usage
      exit 2
      ;;
  esac
done

if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9]+([.-][A-Za-z0-9]+)*)?$ ]]; then
  printf 'Error: --version must be a semantic version such as 0.1.0-alpha.1\n' >&2
  exit 2
fi

case "$architecture" in
  arm64 | x86_64) ;;
  *)
    printf 'Error: unsupported architecture: %s\n' "$architecture" >&2
    exit 2
    ;;
esac

for command in awk codesign hdiutil lipo plutil readlink shasum; do
  if ! command -v "$command" >/dev/null 2>&1; then
    printf 'Error: required command is unavailable: %s\n' "$command" >&2
    exit 1
  fi
done

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH='' cd -- "$script_dir/.." && pwd)

if [ -z "$output_dir" ]; then
  output_dir="$repo_root/dist/$version"
elif [[ "$output_dir" != /* ]]; then
  output_dir="$repo_root/$output_dir"
fi

app_name='Worklings'
executable_name='Worklings'
# Two identifiers are valid while the Godot port runs: the Swift app's original,
# and the deliberately distinct `.godot` one that lets both be installed side by
# side. At cutover the Godot build takes the original and this list loses its
# second entry.
expected_bundle_identifiers=('com.bingeljell.worklings' 'com.bingeljell.worklings.godot')
dmg_name="Worklings-$version-macos-$architecture.dmg"
dmg_path="$output_dir/$dmg_name"
checksum_path="$dmg_path.sha256"

if [ ! -f "$dmg_path" ] || [ ! -f "$checksum_path" ]; then
  printf 'Error: DMG or checksum is missing from: %s\n' "$output_dir" >&2
  exit 1
fi

read -r expected_hash checksum_name <"$checksum_path"
if [ "$checksum_name" != "$dmg_name" ]; then
  printf 'Error: checksum names %s instead of %s\n' "$checksum_name" "$dmg_name" >&2
  exit 1
fi

actual_hash=$(shasum -a 256 "$dmg_path" | awk '{print $1}')
if [ "$actual_hash" != "$expected_hash" ]; then
  printf 'Error: SHA-256 checksum does not match %s\n' "$dmg_name" >&2
  exit 1
fi

hdiutil verify "$dmg_path" >/dev/null

mount_point=$(mktemp -d "${TMPDIR:-/tmp}/worklings-mount.XXXXXX")
mounted=false

cleanup() {
  if [ "$mounted" = true ]; then
    hdiutil detach "$mount_point" >/dev/null 2>&1 || true
  fi
  rmdir "$mount_point" >/dev/null 2>&1 || true
}
trap cleanup EXIT

hdiutil attach -readonly -nobrowse -mountpoint "$mount_point" "$dmg_path" >/dev/null
mounted=true

mounted_app="$mount_point/$app_name.app"
applications_link="$mount_point/Applications"
info_plist="$mounted_app/Contents/Info.plist"
bundle_executable="$mounted_app/Contents/MacOS/$executable_name"

if [ ! -d "$mounted_app" ] || [ ! -x "$bundle_executable" ]; then
  printf 'Error: mounted DMG does not contain a complete app bundle\n' >&2
  exit 1
fi

# The two things that actually go missing from a Godot export, both silently —
# the same pair `scripts/build_dmg` checks before packaging, re-checked here on
# the mounted image so a corrupt or stale DMG cannot pass. The old check was for
# four pixel-art sprite sheets the Swift app carried loose in Resources; the
# Godot build packs its assets into the .pck and the art direction left pixel
# art behind, so that check could only ever fail on a correct bundle.
if [ ! -f "$mounted_app/Contents/Resources/Worklings.pck" ]; then
  printf 'Error: mounted app has no Worklings.pck — it would show a blank window\n' >&2
  exit 1
fi

if ! find "$mounted_app/Contents/Resources" -name 'Worklings.dll' -print -quit | grep -q .; then
  printf 'Error: mounted app has no managed assemblies — it would launch and exit\n' >&2
  printf 'in silence. See scripts/godot-export.\n' >&2
  exit 1
fi

# The in-app connector wires Claude Code / Codex to these bundled scripts, and
# each must be present *and* executable or a DMG install cannot connect a tool
# (the connector refuses a non-executable adapter). Mirror godot-export's
# layout: Resources/adapters/<adapter> and Resources/emit-activity-event.
for bundled_script in \
  adapters/worklings-claude-code-activity-hook \
  adapters/worklings-codex-activity-hook \
  emit-activity-event; do
  script_path="$mounted_app/Contents/Resources/$bundled_script"
  if [ ! -f "$script_path" ]; then
    printf 'Error: mounted app is missing bundled script: %s\n' "$bundled_script" >&2
    exit 1
  fi
  if [ ! -x "$script_path" ]; then
    printf 'Error: bundled script is not executable: %s\n' "$bundled_script" >&2
    exit 1
  fi
done

if [ ! -L "$applications_link" ] || [ "$(readlink "$applications_link")" != '/Applications' ]; then
  printf 'Error: mounted DMG does not contain the expected Applications shortcut\n' >&2
  exit 1
fi

plutil -lint "$info_plist" >/dev/null
bundle_identifier=$(plutil -extract CFBundleIdentifier raw -o - "$info_plist")
bundle_version=$(plutil -extract CFBundleShortVersionString raw -o - "$info_plist")
build_number=$(plutil -extract CFBundleVersion raw -o - "$info_plist")
# The Swift bundle wrote a flat LSMinimumSystemVersion; the Godot export writes
# LSMinimumSystemVersionByArchitecture instead, so read whichever is present.
if minimum_system=$(plutil -extract LSMinimumSystemVersion raw -o - "$info_plist" 2>/dev/null); then
  :
else
  minimum_system=$(plutil -extract LSMinimumSystemVersionByArchitecture.arm64 raw -o - "$info_plist")
fi

identifier_ok=false
for candidate in "${expected_bundle_identifiers[@]}"; do
  if [ "$bundle_identifier" = "$candidate" ]; then
    identifier_ok=true
    break
  fi
done
if [ "$identifier_ok" != true ]; then
  printf 'Error: unexpected bundle identifier: %s\n' "$bundle_identifier" >&2
  exit 1
fi

# CFBundleShortVersionString holds the semantic core only — macOS allows at most
# three dot-separated integers there — so the prerelease label is carried by the
# tag and the release rather than by the bundle. Same rule as build_dmg.
version_core=${version%%-*}
if [ "$bundle_version" != "$version_core" ]; then
  printf 'Error: mounted app version %s does not match %s (core %s)\n' \
    "$bundle_version" "$version" "$version_core" >&2
  exit 1
fi

if [[ ! "$build_number" =~ ^[1-9][0-9]*$ ]]; then
  printf 'Error: invalid bundle build number: %s\n' "$build_number" >&2
  exit 1
fi

# '14.00' is how the Godot export spells it; '14.0' is how the Swift builder did.
if [ "$minimum_system" != '14.0' ] && [ "$minimum_system" != '14.00' ]; then
  printf 'Error: unexpected minimum macOS version: %s\n' "$minimum_system" >&2
  exit 1
fi

lipo "$bundle_executable" -verify_arch "$architecture"
codesign --verify --deep --strict --verbose=2 "$mounted_app"

hdiutil detach "$mount_point" >/dev/null
mounted=false
rmdir "$mount_point"
trap - EXIT

printf 'Release verification passed:\n'
printf '  Artifact: %s\n' "$dmg_path"
printf '  Version: %s (%s)\n' "$bundle_version" "$build_number"
printf '  Architecture: %s\n' "$architecture"
printf '  Minimum macOS: %s\n' "$minimum_system"
printf '  SHA-256: %s\n' "$actual_hash"
